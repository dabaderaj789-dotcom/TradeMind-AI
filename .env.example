# Application
APP_NAME=TradeMind AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database — local Docker Compose defaults
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trademind
POSTGRES_PASSWORD=trademind_secret
POSTGRES_DB=trademind_db
DATABASE_ECHO=false

# Neon (cloud): paste the connection string instead of POSTGRES_* above.
# Use the "direct" (non-pooler) URL for Alembic migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# CORS (comma-separated origins). Include your LAN IP for iPhone / Wi-Fi access.
# After Vercel deploy, add: https://YOUR-TERMINAL.vercel.app,https://YOUR-STUDIO.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175,http://192.168.0.133:5173,http://192.168.0.133:5175

# Optional: force the LAN IP printed for phones (auto-detected if unset)
# TRADEMIND_HOST=192.168.0.133

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Market-data Provider Abstraction Layer
# Switch live India / option-chain / crypto feeds without changing chart or AI code.
# Valid: yahoo_nse | binance | angel | upstox | dhan | zerodha | truedata | global_datafeeds
MARKET_DATA_INDIA_PROVIDER=yahoo_nse
MARKET_DATA_CRYPTO_PROVIDER=binance
MARKET_DATA_OPTION_CHAIN_PROVIDER=yahoo_nse

# Optional broker/vendor credentials (required only when that provider is selected)
# ANGEL_API_KEY=
# ANGEL_CLIENT_CODE=
# ANGEL_API_SECRET=
# ANGEL_PASSWORD=          # 4-digit Angel PIN
# ANGEL_TOTP_SECRET=       # QR / authenticator secret from SmartAPI portal
#
# Algo execution — PAPER by default. Live needs BOTH flags + kill switch off.
# TRADING_MODE=paper
# TRADING_LIVE_ENABLED=false
# TRADING_KILL_SWITCH=false
# TRADING_MAX_QTY=50
# TRADING_MAX_ORDERS_PER_DAY=20
# To use Angel as India tip feed: MARKET_DATA_INDIA_PROVIDER=angel

# Email signal alerts (no chart / no Angel required)
# ALERTS_ENABLED=true
# ALERT_EMAIL_TO=you@gmail.com
# ALERT_WATCHLIST=NIFTY50:5m,BANKNIFTY:5m
# ALERT_INTERVAL_SEC=180
# ALERT_MIN_CONFIDENCE=60
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_FROM=TradeMind <you@gmail.com>
# SMTP_USE_TLS=true
# UPSTOX_API_KEY=
# UPSTOX_ACCESS_TOKEN=
# DHAN_ACCESS_TOKEN=
# DHAN_CLIENT_ID=
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=
# TRUEDATA_USERNAME=
# TRUEDATA_PASSWORD=
# GFDL_API_KEY=
